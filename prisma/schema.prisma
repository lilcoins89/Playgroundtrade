generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Trade {
  id                    String   @id @default(cuid())
  mode                  String
  type                  String
  tokenId               String
  tokenSymbol           String
  solAmount             Decimal  @db.Decimal(30, 12)
  tokenAmount           Decimal  @db.Decimal(30, 12)
  executionPriceSol     Decimal  @db.Decimal(30, 12)
  feeSol                Decimal  @db.Decimal(30, 12)
  priceImpactPct        Decimal  @db.Decimal(12, 6)
  slippageTolerancePct  Decimal  @db.Decimal(12, 6)
  timestamp             BigInt
  txSignature           String?
  realizedPnLSol        Decimal? @db.Decimal(30, 12)
  notes                 String?
  createdAt             DateTime @default(now())

  @@index([tokenId, timestamp])
  @@index([mode, timestamp])
}
